FROM python:3.12-slim

WORKDIR /app

ARG INSTALL_DEMUCS=0
ARG INSTALL_BASIC_PITCH=0

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY workers/audio/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Inferência real (CPU). Imagem fica bem maior (~2GB+). Build:
#   docker compose build --build-arg INSTALL_DEMUCS=1 worker
COPY workers/audio/requirements-demucs.txt /tmp/requirements-demucs.txt
# Torch CPU (imagem menor que CUDA). GPU: troque o index para cu121 se necessário.
RUN if [ "$INSTALL_DEMUCS" = "1" ]; then \
      pip install --no-cache-dir \
        torch torchaudio --index-url https://download.pytorch.org/whl/cpu && \
      pip install --no-cache-dir "numpy<2.3" "demucs>=4.0.1"; \
    fi

# Basic Pitch (MIT) — opcional; TensorFlow pesado. Fallback YIN já vem no requirements base.
COPY workers/audio/requirements-basic-pitch.txt /tmp/requirements-basic-pitch.txt
RUN if [ "$INSTALL_BASIC_PITCH" = "1" ]; then \
      pip install --no-cache-dir -r /tmp/requirements-basic-pitch.txt; \
    fi

COPY workers/audio /app

ENV WORKER_TMP_DIR=/tmp/estudio-worker
RUN mkdir -p /tmp/estudio-worker

CMD ["celery", "-A", "worker.celery_app", "worker", "--loglevel=INFO", "--concurrency=1"]
