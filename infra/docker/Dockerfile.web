# CVE-2026-111497 (Node2Shell / Brotli): Node 20 está EOL e sem patch.
# Use linha 24.x corrigida (>= 24.22.1) ou 22.x (>= 22.23.4).
# Confirme a tag/digest no build: docker pull node:24.22.1-alpine
FROM node:24.22.1-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY apps/web/package.json ./
RUN pnpm install

COPY apps/web ./

EXPOSE 3000

CMD ["pnpm", "dev", "--hostname", "0.0.0.0", "--port", "3000"]
