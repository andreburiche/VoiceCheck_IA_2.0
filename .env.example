# === Ambiente geral ===
# development | dev | local | test → cria contas de teste (senha pública).
# Qualquer outro valor (staging, production) NÃO cria. Em production a API
# recusa subir com JWT/CSRF de exemplo, COOKIE_SECURE=false ou ALLOW_CONTRACT_STEMS=1.
APP_ENV=development
APP_NAME=Estudio Musical
PUBLIC_WEB_URL=http://localhost:3000
# A API é publicada na porta 8010 do host (a 8000 costuma ser do PHP/XAMPP).
PUBLIC_API_URL=http://127.0.0.1:8010

# === MySQL ===
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=estudio_musical
MYSQL_USER=estudio
MYSQL_PASSWORD=change_me_dev_only
MYSQL_ROOT_PASSWORD=change_me_root_dev_only
DATABASE_URL=mysql+pymysql://estudio:change_me_dev_only@mysql:3306/estudio_musical

# === Redis / Celery ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# === Auth ===
# Em produção: gere secrets aleatórios (≥32 chars) e NÃO use estes placeholders.
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Produção com HTTPS: COOKIE_SECURE=true (obrigatório para cookies de sessão).
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
CSRF_SECRET=change_me_csrf_secret_also_long_random

# Rate limit (0 = off). Auth = login+register; upload = initiate
RATE_LIMIT_AUTH=20
RATE_LIMIT_AUTH_WINDOW_SEC=60
RATE_LIMIT_UPLOAD=30
RATE_LIMIT_UPLOAD_WINDOW_SEC=60
# IPs de proxies reversos confiáveis (ex.: nginx/Cloudflare tunnel), separados por vírgula.
# Só deles o X-Forwarded-For é aceito. Vazio = usa o IP da conexão (seguro por padrão).
TRUSTED_PROXIES=

# /metrics: defina um token para exigir "Authorization: Bearer <token>".
# Em APP_ENV=production sem token, /metrics fica desativado.
METRICS_TOKEN=

# VoiceCheck: horas até apagar arquivos de análises abandonadas (0 = nunca).
VOICECHECK_JOB_TTL_HOURS=24

# === CORS ===
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === Storage ===
# local = disco no container (padrão em dev sem MinIO)
# s3 = MinIO/S3-compatible
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/audio

# === S3 / MinIO (quando STORAGE_BACKEND=s3) ===
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=estudio-audio
S3_REGION=us-east-1
S3_PRESIGN_TTL_SECONDS=300

# === Uploads / cotas (dev) ===
MAX_UPLOAD_BYTES=104857600
MAX_DURATION_SECONDS=600
DEFAULT_PLAN_CODE=free

# === Worker / IA ===
SEPARATION_ADAPTER=contract
# Opções: contract | cpu_demucs | gpu_demucs
# ALLOW_CONTRACT_STEMS=1 apenas para smoke do pipeline (stems silenciosos — NÃO é Demucs)
ALLOW_CONTRACT_STEMS=0
DEMUCS_MODEL=htdemucs
WORKER_TMP_DIR=/tmp/estudio-worker
INFERENCE_TIMEOUT_SECONDS=1800

# === Next.js (apps/web) ===
NEXT_PUBLIC_API_URL=http://127.0.0.1:8010
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-mail (link de "Esqueci minha senha"). Sem SMTP_HOST, em dev o link aparece na tela.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VoiceCheck IA <no-reply@seudominio.com>
SMTP_STARTTLS=true
PASSWORD_RESET_TTL_MINUTES=30
