  "narrative": {
    "northStar": "O Estúdio de Gravação",
    "overview": "O portal é uma sala de controle à noite: superfícies escuras e opacas, como racks de equipamento, onde a única luz forte é a dos medidores — o turquesa. Tudo que acende significa algo: uma ação disponível, uma seleção, um valor medido. O resto fica quieto para a música e os números aparecerem. Nas telas do app o visual é sóbrio e preciso: ferramenta antes de efeito, densidade de mesa de som, mesmo vocabulário em todas as páginas. A página inicial pode ter mais atmosfera, mas usa os mesmos tokens e no máximo uma camada atmosférica por seção.",
    "keyCharacteristics": [
      "Fundo escuro em camadas tonais; cartões e painéis opacos com borda fina.",
      "Turquesa só para ação, seleção e medição; laranja só para \"ao vivo\", picos e alertas.",
      "Fonte mono só para números com unidade (tempo, cents, Hz, BPM, tamanhos).",
      "Cada faixa tem sua cor fixa (voz, bateria, baixo, outros)."
    ],
    "rules": [
      { "name": "The Meter Light Rule", "body": "O turquesa é luz de medidor: se não é ação, seleção ou medida, não é turquesa.", "section": "colors" },
      { "name": "The REC Rule", "body": "Laranja só acende quando algo está acontecendo ou precisa de atenção agora.", "section": "colors" },
      { "name": "The No Kicker Rule", "body": "Nenhuma etiqueta pequena acima de título. O título fala sozinho.", "section": "typography" },
      { "name": "The 12px Floor Rule", "body": "Nada menor que 12px (0.75rem).", "section": "typography" },
      { "name": "The No Glow Rule", "body": "Nada de brilho colorido em volta de botões, cartões ou texto.", "section": "elevation" }
    ],
    "dos": [
      "Do usar um único h1 por página, em Headline (1.75rem, 600).",
      "Do manter 24px entre blocos de página e 16px dentro de seções.",
      "Do mostrar números medidos em Data (mono tabular) com a unidade.",
      "Do usar a cor fixa de cada faixa sempre que a faixa aparecer.",
      "Do construir janelas sobre <dialog> nativo, com foco no \"Cancelar\" em ações destrutivas."
    ],
    "donts": [
      "Don't usar vidro desfocado em cartões ou painéis.",
      "Don't colocar grade decorativa ou manchas de luz atrás do conteúdo das telas do app.",
      "Don't usar texto em degradê, bordas laterais coloridas grossas ou brilho em volta de elementos.",
      "Don't usar laranja em botões ou como enfeite.",
      "Don't usar mono ou caixa alta em rótulos e títulos.",
      "Don't desenhar formas de onda, números ou selos \"ao vivo\" que não venham de dados reais."
    ]
  }
